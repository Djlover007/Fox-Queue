{
  "name": "fox-queue",
  "productName": "Fox Queue",
  "version": "1.0.0",
  "description": "Drop- und Queue-Monitor: meldet per Benachrichtigung und Discord, sobald eine Warteschlange oder ein Drop live geht.",
  "main": "desktop/main.js",
  "author": "Djlover007",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "de.djlover007.foxqueue",
    "productName": "Fox Queue",
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Djlover007",
        "repo": "Fox-Queue-Downloads",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ui/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FoxQueue-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FoxQueue-Portable-${version}.exe"
    }
  }
}
